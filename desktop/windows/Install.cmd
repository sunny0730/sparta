@echo off
setlocal
chcp 65001 >nul
set "CHAGEUN_INSTALL_DIR=%~dp0"
set "CHAGEUN_INSTALL_LOG=%TEMP%\Chageun-Install.log"
echo Installing Chageun. Please wait...
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; $ErrorActionPreference='Stop'; try { Write-Host 'Chageun desktop setup - diagnostic version'; $source=Join-Path $env:CHAGEUN_INSTALL_DIR 'chageun.html'; Write-Host ('Source: '+$source); if (!(Test-Path -LiteralPath $source -PathType Leaf)) { throw 'Extract all ZIP files first. chageun.html must be next to Install.cmd.' }; $roots=@(${env:ProgramFiles(x86)},$env:ProgramFiles,$env:LOCALAPPDATA) | Where-Object { $_ }; $candidates=@(foreach ($relative in @('Microsoft\Edge\Application\msedge.exe','Google\Chrome\Application\chrome.exe')) { foreach ($root in $roots) { Join-Path $root $relative } }); $browser=$candidates | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } | Select-Object -First 1; if (!$browser) { throw 'Microsoft Edge or Google Chrome is required.' }; $folder=Join-Path $env:LOCALAPPDATA 'Chageun'; $appFile=Join-Path $folder 'chageun.html'; $profile=Join-Path $folder 'BrowserProfile'; $marker=Join-Path $folder '.chageun-installed'; if ((Test-Path -LiteralPath $appFile) -and !(Test-Path -LiteralPath $marker)) { throw 'An unrelated chageun.html exists in LocalAppData\Chageun. No file was replaced.' }; $shell=New-Object -ComObject WScript.Shell; $desktop=$shell.SpecialFolders.Item('Desktop'); if (!$desktop) { $desktop=[Environment]::GetFolderPath('DesktopDirectory') }; if (!$desktop -or !(Test-Path -LiteralPath $desktop -PathType Container)) { throw 'The Windows Desktop folder is not available.' }; Write-Host ('Desktop folder: '+$desktop); Write-Host ('App folder: '+$folder); Write-Host ('Browser: '+$browser); $quote=[string][char]34; $uri=([Uri]$appFile).AbsoluteUri; $arguments='--user-data-dir='+$quote+$profile+$quote+' --app='+$quote+$uri+$quote+' --no-first-run'; New-Item -ItemType Directory -Path $folder -Force | Out-Null; Copy-Item -LiteralPath $source -Destination $appFile -Force; [IO.File]::WriteAllText($marker,'Chageun desktop installer v2'); function Save-ChageunShortcut([string]$desired) { $path=$desired; if (Test-Path -LiteralPath $path) { $old=$shell.CreateShortcut($path); if ($old.Description -ne 'Chageun - Today planner' -or $old.WorkingDirectory -ne $folder -or !$old.Arguments.Contains($profile)) { $path=Join-Path ([IO.Path]::GetDirectoryName($desired)) ('Chageun-'+[Guid]::NewGuid().ToString('N').Substring(0,8)+'.lnk') }; }; $link=$shell.CreateShortcut($path); $link.TargetPath=$browser; $link.Arguments=$arguments; $link.WorkingDirectory=$folder; $link.IconLocation=$browser+',0'; $link.Description='Chageun - Today planner'; $link.Save(); if (!(Test-Path -LiteralPath $path -PathType Leaf)) { throw ('Shortcut was not created: '+$path) }; return $path; }; $name=([string][char]0xCC28)+[char]0xADFC; $localShortcut=Save-ChageunShortcut (Join-Path $folder 'Chageun.lnk'); $desktopShortcut=Save-ChageunShortcut (Join-Path $desktop ($name+'.lnk')); $result=Join-Path $folder 'Install-result.txt'; @('Chageun installed successfully.';('Desktop shortcut: '+$desktopShortcut);('App folder: '+$folder);('Backup shortcut: '+$localShortcut);('Log: '+$env:CHAGEUN_INSTALL_LOG)) | Set-Content -LiteralPath $result -Encoding UTF8; Write-Host ('Desktop shortcut created: '+$desktopShortcut); Write-Host ('Backup shortcut: '+$localShortcut); Write-Host ('Result file: '+$result); Start-Process -FilePath explorer.exe -ArgumentList ('/select,'+$quote+$desktopShortcut+$quote); Start-Process -FilePath $browser -ArgumentList $arguments; Write-Host 'Done. The Explorer window shows your shortcut. This setup window stays open until you press a key.'; } catch { Write-Host ('Installation failed: '+$_.Exception.Message); Write-Host ('Step: '+$_.InvocationInfo.PositionMessage); exit 1 }" > "%CHAGEUN_INSTALL_LOG%" 2>&1
set "CHAGEUN_INSTALL_EXIT=%ERRORLEVEL%"
type "%CHAGEUN_INSTALL_LOG%"
if not "%CHAGEUN_INSTALL_EXIT%"=="0" (
  echo Setup failed. The error log will open in Notepad.
  start "" notepad.exe "%CHAGEUN_INSTALL_LOG%"
)
echo.
echo Log file: %CHAGEUN_INSTALL_LOG%
echo Please keep this window open if you need help.
pause
exit /b %CHAGEUN_INSTALL_EXIT%
