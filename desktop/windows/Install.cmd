@echo off
setlocal
set "CHAGEUN_INSTALL_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; try { $source=Join-Path $env:CHAGEUN_INSTALL_DIR 'chageun.html'; if (!(Test-Path -LiteralPath $source -PathType Leaf)) { throw 'Extract the ZIP first. chageun.html must be next to Install.cmd.' }; $roots=@(${env:ProgramFiles(x86)},$env:ProgramFiles,$env:LOCALAPPDATA) | Where-Object { $_ }; $candidates=@(foreach ($relative in @('Microsoft\Edge\Application\msedge.exe','Google\Chrome\Application\chrome.exe')) { foreach ($root in $roots) { Join-Path $root $relative } }); $browser=$candidates | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } | Select-Object -First 1; if (!$browser) { throw 'Microsoft Edge or Google Chrome is required.' }; $folder=Join-Path $env:LOCALAPPDATA 'Chageun'; $appFile=Join-Path $folder 'chageun.html'; $profile=Join-Path $folder 'BrowserProfile'; $marker=Join-Path $folder '.chageun-installed'; if ((Test-Path -LiteralPath $appFile) -and !(Test-Path -LiteralPath $marker)) { throw 'An unrelated chageun.html already exists in LocalAppData\Chageun. No file was replaced.' }; $name=([string][char]0xCC28)+[char]0xADFC; $desktop=[Environment]::GetFolderPath('Desktop'); if (!$desktop -or !(Test-Path -LiteralPath $desktop -PathType Container)) { throw 'The Desktop folder is not available.' }; $shortcutPath=Join-Path $desktop ($name+'.lnk'); $shell=New-Object -ComObject WScript.Shell; $quote=[string][char]34; $uri=([Uri]$appFile).AbsoluteUri; $arguments='--user-data-dir='+$quote+$profile+$quote+' --app='+$quote+$uri+$quote+' --no-first-run'; if (Test-Path -LiteralPath $shortcutPath) { $existing=$shell.CreateShortcut($shortcutPath); if ($existing.Arguments -ne $arguments) { throw 'A different shortcut named Chageun already exists. No shortcut was replaced.' } }; New-Item -ItemType Directory -Path $folder -Force | Out-Null; Copy-Item -LiteralPath $source -Destination $appFile -Force; [IO.File]::WriteAllText($marker,'Chageun desktop installer v1'); $shortcut=$shell.CreateShortcut($shortcutPath); $shortcut.TargetPath=$browser; $shortcut.Arguments=$arguments; $shortcut.WorkingDirectory=$folder; $shortcut.IconLocation=$browser+',0'; $shortcut.Description='Chageun - Today planner'; $shortcut.Save(); Write-Host 'Installed! Your Desktop shortcut is ready.'; Write-Host 'Your schedule stays on this PC in the dedicated browser profile.'; Start-Process -FilePath $browser -ArgumentList $arguments } catch { Write-Host ('Installation failed: '+$_.Exception.Message); exit 1 }"
if errorlevel 1 (
  echo Please copy the error message if you need help.
  pause
  exit /b 1
)
endlocal
