@echo off
setlocal
chcp 65001 >nul
set "CHAGEUN_ICON_SOURCE=%~dp0"
set "CHAGEUN_ICON_LOG=%TEMP%\Chageun-Icon.log"
echo Creating a new Chageun shortcut with the custom icon...
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; $ErrorActionPreference='Stop'; try { Write-Host 'Chageun icon repair v2 - create a fresh shortcut'; $folder=Join-Path $env:LOCALAPPDATA 'Chageun'; $profile=Join-Path $folder 'BrowserProfile'; $appFile=Join-Path $folder 'chageun.html'; if (!(Test-Path -LiteralPath (Join-Path $folder '.chageun-installed') -PathType Leaf) -or !(Test-Path -LiteralPath $appFile -PathType Leaf)) { throw 'The installed app was not found. No app files or records were changed.' }; $source=Join-Path $env:CHAGEUN_ICON_SOURCE 'chageun-icon-v1.ico'; if (!(Test-Path -LiteralPath $source -PathType Leaf)) { throw 'Extract all ZIP contents first. The ICO file must be next to Change-icon.cmd.' }; $roots=@(${env:ProgramFiles(x86)},$env:ProgramFiles,$env:LOCALAPPDATA) | Where-Object { $_ }; $candidates=@(foreach ($relative in @('Microsoft\Edge\Application\msedge.exe','Google\Chrome\Application\chrome.exe')) { foreach ($root in $roots) { Join-Path $root $relative } }); $browser=$candidates | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } | Select-Object -First 1; if (!$browser) { throw 'Microsoft Edge or Google Chrome is required.' }; $shell=New-Object -ComObject WScript.Shell; $desktop=$shell.SpecialFolders.Item('Desktop'); if (!$desktop) { $desktop=[Environment]::GetFolderPath('DesktopDirectory') }; if (!$desktop -or !(Test-Path -LiteralPath $desktop -PathType Container)) { throw 'The Desktop folder could not be found.' }; $iconFile=Join-Path $folder 'chageun-check-sprout-v2.ico'; Copy-Item -LiteralPath $source -Destination $iconFile -Force; $name=-join ([char[]](0xCC28,0xADFC,0x20,0x28,0xC0C8,0x20,0xC544,0xC774,0xCF58,0x29)); $shortcutPath=Join-Path $desktop ($name+'.lnk'); if (Test-Path -LiteralPath $shortcutPath) { $shortcutPath=Join-Path $desktop ($name+'-'+[Guid]::NewGuid().ToString('N').Substring(0,8)+'.lnk') }; $quote=[string][char]34; $uri=([Uri]$appFile).AbsoluteUri; $link=$shell.CreateShortcut($shortcutPath); $link.TargetPath=$browser; $link.Arguments='--user-data-dir='+$quote+$profile+$quote+' --app='+$quote+$uri+$quote+' --no-first-run'; $link.WorkingDirectory=$folder; $link.IconLocation=$iconFile+',0'; $link.Description='Chageun - Today planner'; $link.Save(); if (!(Test-Path -LiteralPath $shortcutPath -PathType Leaf)) { throw 'The shortcut could not be saved.' }; $check=$shell.CreateShortcut($shortcutPath); if (($check.IconLocation -replace '[\x22]','') -ne ($iconFile+',0')) { throw 'The saved shortcut icon could not be verified.' }; Write-Host ('New shortcut: '+$shortcutPath); Write-Host ('Icon file: '+$iconFile); Write-Host ('Existing app and profile preserved: '+$folder); Start-Process -FilePath explorer.exe -ArgumentList ('/select,'+$quote+$shortcutPath+$quote); Write-Host 'Done. A new check-and-sprout shortcut is selected in Explorer.'; Write-Host 'The old shortcut was kept. Your app, diary, memos, and browser profile were not changed.'; } catch { Write-Host ('Icon repair failed: '+$_.Exception.Message); exit 1 }" > "%CHAGEUN_ICON_LOG%" 2>&1
set "CHAGEUN_ICON_EXIT=%ERRORLEVEL%"
type "%CHAGEUN_ICON_LOG%"
if not "%CHAGEUN_ICON_EXIT%"=="0" start "" notepad.exe "%CHAGEUN_ICON_LOG%"
echo.
echo Log file: %CHAGEUN_ICON_LOG%
pause
exit /b %CHAGEUN_ICON_EXIT%
